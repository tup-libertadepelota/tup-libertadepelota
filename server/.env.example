PORT=3001
# Se pueden indicar varios origenes separados por coma.
CLIENT_ORIGIN=http://localhost:5173
API_KEY_FOOTBALL=

# Opcional para hosting fuera de Google Cloud: JSON completo de la cuenta de
# servicio en una sola linea. En Cloud Run se usan Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT=

# Desarrollo local: si FIREBASE_SERVICE_ACCOUNT esta vacia, se usa
# config/firebase-service-account.json (archivo ignorado por Git). Si tampoco
# existe, Firebase Admin usa Application Default Credentials.
