{
  "name": "tup-libertadepelota",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:visualizer": "node ./scripts/generate-visualizer.mjs",
    "lint": "eslint . --ext .js,.jsx",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"src/**/*.{js,jsx,css,html}\"",
    "prepare": "cd .. && husky client/.husky",
    "preview": "vite preview",
    "deploy": "firebase deploy --only hosting",
    "start:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "build:mobile": "vite build",
    "android": "npm run build:mobile && npx cap sync android && npx cap open android",
    "android:init": "rimraf android && npm run build:mobile && npx cap add android && npx cap sync android && npx cap open android"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@sentry/react": "^10.57.0",
    "firebase": "^12.13.0",
    "i18next": "^26.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.18.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
